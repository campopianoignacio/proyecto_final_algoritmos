unit Validaciones;

interface
uses
  Tipos;

function cargarDni(): TDni;
function cargarFecha(): TFecha;

implementation

function dniValido(dni: TDni): Boolean;
begin
  // Lógica de validar un DNI
  dniValido := true;
end;

function cargarDni(): TDni;
var dni: TDni;
begin
  repeat
    write('DNI del cliente: ');
    readLn(dni);
    if dniValido(dni) = false then
    begin
      dni := '';
      writeLn('DNI inválido: solo dígitos entre 7 y 8 de longitud');
    end;
  until dni <> '';
  cargarDni := dni;
end;

function diasDelMes(mes: integer; anio: integer): integer;
var
  dias: integer;
begin
  case mes of
    1, 3, 5, 7, 8, 10, 12: dias := 31;
    4, 6, 9, 11: dias := 30;
    2: begin
       // Validación de año bisiesto
       if ((anio mod 4 = 0) and (anio mod 100 <> 0)) or (anio mod 400 = 0) then
         dias := 29
       else
         dias := 28;
       end;
  end;
  diasDelMes := dias;
end;

function cargarFecha(): TFecha;
var
  f: TFecha;
  maxDias: integer;
begin
  writeln('--- Fecha de Nacimiento ---');

  repeat
    write('Año: ');
    readln(f.anio);
    if (f.anio < 1900) or (f.anio > 2026) then
      writeln('Año inválido, ingréselo de nuevo.');
  until (f.anio >= 1900) and (f.anio <= 2026);

  repeat
    write('Mes (1-12): ');
    readln(f.mes);
    if (f.mes < 1) or (f.mes > 12) then
      writeln('Mes inválido, ingréselo de nuevo.');
  until (f.mes >= 1) and (f.mes <= 12);

  // Calculamos el tope de días real para el mes y año ingresados
  maxDias := diasDelMes(f.mes, f.anio);

  repeat
    write('Día (1-', maxDias, '): ');
    readln(f.dia);
    if (f.dia < 1) or (f.dia > maxDias) then
      writeln('Día inválido, ingréselo de nuevo.');
  until (f.dia >= 1) and (f.dia <= maxDias);

  cargarFecha := f;
end;

end.

end.

